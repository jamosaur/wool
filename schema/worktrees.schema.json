{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/svenluijten/wool/main/schema/worktrees.schema.json",
  "title": "wool setup file (.herdr/worktrees.yml(.dist)), herdr-dog's schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "worktrees"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "worktrees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup"
      ],
      "properties": {
        "setup": {
          "type": "array",
          "description": "Steps run in order in the new worktree; the first failure stops setup.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Label shown while it runs."
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "description": "Run as /bin/sh -c <run> in the new worktree."
              },
              "env": {
                "type": "object",
                "description": "Environment variables (NAME: value).",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
